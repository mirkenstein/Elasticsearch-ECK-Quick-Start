###########################
# Inference endpoints
###########################

#Open AI
# --------------------------------------
PUT _inference/text_embedding/openai-embeddings
{
    "service": "openai",
    "service_settings": {
        "api_key": "${OPEN_AI_API_KEY}",
        "model_id": "text-embedding-ada-002"
    }
}


PUT _inference/completion/openai-completion-gpt-3.5-turbo
{
    "service": "openai",
    "service_settings": {
        "api_key": "${OPEN_AI_API_KEY}",
        "model_id": "gpt-3.5-turbo"
    }
}

# Kohere
# ----------------

PUT _inference/text_embedding/cohere-embeddings
{
    "service": "cohere",
    "service_settings": {
        "api_key": "${KOHERE_API_KEY}",
        "model_id": "embed-english-light-v3.0",
        "embedding_type": "byte"
    }
}


PUT _inference/rerank/cohere-rerank
{
  "service": "cohere",
  "service_settings": {
    "api_key": "${KOHERE_API_KEY}",
    "model_id": "rerank-english-v3.0"
  },
  "task_settings": {
    "top_n": 10,
    "return_documents": true
  }
}

# Anthropic
# -----------------

PUT _inference/completion/anthropic_completion_claude-3-5-sonne
{
    "service": "anthropic",
    "service_settings": {
        "api_key": "${ANTHROPIC_API_KEY}",
        "model_id": "claude-3-5-sonnet-20240620"
    },
    "task_settings": {
        "max_tokens": 1024
    }
}
