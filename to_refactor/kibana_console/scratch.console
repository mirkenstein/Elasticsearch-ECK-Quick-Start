#  
POST _ml/trained_models/maarsen__setfit-absa-paraphrase-mpnet-base-v2-restaurants-aspect/_infer
{
  "docs": [
    {"text_field":"The food was great, but the venue is just way too busy."},
    {
      "text_field": "Best pizza outside of Italy and really tasty"
    },
    {
      "text_field": "The food variations are great and the prices are absolutely fair."
    },
    {
      "text_field": "Unfortunately, you have to expect some waiting time and get a note with a waiting number if it should be very full."
    }
  ],
  "inference_config": {
    "text_classification": {
      "classification_labels": [
        "food",
        "service"
      ]
    }
  }
}
